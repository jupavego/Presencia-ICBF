# Copie este archivo a .env y complete con las credenciales de su proyecto
# de Supabase (Project Settings → API en el dashboard de supabase.com).
# Nunca comitee el archivo .env real — solo este .example queda en git.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional, solo para desarrollo local: si se completan, `npm run dev`
# inicia sesión sola con estas credenciales al cargar (evita loguearse a
# mano en cada pestaña nueva del navegador durante el desarrollo). Nunca
# tiene efecto en `npm run build` / producción — ver AuthContext.jsx.
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=
